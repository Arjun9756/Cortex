# Cortex Frontend Environment Configuration (Example)

# Feature Flag: Enable/Disable Live Platform Demo & Main Chat (true / false)
# Set to true to enable the "Launch Live Demo" button and main chat/dashboard view.
# Set to false to disable demo buttons and restrict live chat access in production deployments.
VITE_ENABLE_DEMO=true

# Backend API URL for Live Demo & Dashboard (Default: http://localhost:3000)
# Change this URL if you shift ports or deploy to a remote server.
VITE_API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_DEMO_API_URL=http://localhost:3000
