# Cortex BYOC Deployment Configuration
PORT=3000
NODE_ENV=development

# Deployment Webhook Base URL (used when registering webhooks automatically with providers)
DEPLOYMENT_WEBHOOK_BASE_URL=http://localhost:3000

# Webhook Shared Signing Secrets (used for signature verification: HMAC SHA-256)
GITHUB_WEBHOOK_SECRET=cortex_github_webhook_secret_key_12345
SLACK_SIGNING_SECRET=cortex_slack_signing_secret_key_12345
JIRA_WEBHOOK_SECRET=cortex_jira_webhook_secret_key_12345

# Optional: Real OAuth App Credentials (if using live OAuth instead of simulated/demo mode)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
